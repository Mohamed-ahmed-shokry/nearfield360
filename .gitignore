# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/

# Builds and native outputs
build/
dist/
*.egg-info/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
compile_commands.json
cmake-build-*/
out/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
.env.*
!.env.example
/configs/local/

# Datasets, model artifacts, and experiment outputs
/data/
/datasets/
/checkpoints/
/weights/
/runs/
/outputs/
/artifacts/
*.ckpt
*.engine
*.onnx
*.pt
*.pth

# Allow deliberately tiny, reviewable regression artifacts.
!tests/fixtures/**/*.onnx
!tests/fixtures/**/*.pt
!tests/fixtures/**/*.pth

# Generated media and profiling traces
*.mp4
*.avi
*.gif
*.prof
*.trace
